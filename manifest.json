{
  "manifest_version": 3,
  "name": "Bale Chat Export",
  "version": "1.2.0",
  "description": "Export one complete Bale Web conversation as a Telegram-style HTML and JSON archive.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://web.bale.ai/*", "https://*.bale.ai/*"],
  "action": {
    "default_title": "Export Bale chat",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.bale.ai/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.bale.ai/*"],
      "js": ["lib/zip.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
